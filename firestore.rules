rules_version = '2';

/**
 * Firestore Security Rules for No-Due Automation System
 * 
 * SCHEMA CHANGES:
 * - students collection: Document ID is usn (not uid)
 * - teachers collection: Document ID is employeeId (not uid)  
 * - admins collection: Document ID is adminId (not uid)
 * - users collection: Stores role and profileId (links uid to profile)
 * - New collections: curriculum, core_subject_teacher_mapping, 
 *   open_elective_offerings, student_elective_choice,
 *   common_clearance_types, common_clearance_mapping, no_due_requests
 */
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function getProfileId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileId;
    }
    
    function isStudent() {
      return isAuthenticated() && getUserRole() == 'student';
    }
    
    function isTeacher() {
      return isAuthenticated() && getUserRole() == 'teacher';
    }
    
    function isDepartmentAdmin() {
      return isAuthenticated() && getUserRole() == 'department_admin';
    }
    
    function isAdminUser() {
      return isAuthenticated() && (getUserRole() == 'department_admin' || getUserRole() == 'admin');
    }
    
    // =========================================================================
    // USERS COLLECTION (uid-based, stores role and profileId)
    // =========================================================================
    
    match /users/{userId} {
      // Users can only read their own role document
      // Admins can read user role documents
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdminUser());
      
      // Users can create their own role document during signup
      // Admins can create role documents for new accounts
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdminUser());
      
      // Prevent updates and deletes (role should not change)
      allow update, delete: if false;
    }
    
    // =========================================================================
    // STUDENTS COLLECTION (Document ID: usn)
    // =========================================================================
    
    match /students/{usn} {
      // Allow unauthenticated GET (needed for USN+DOB login verification)
      allow get: if !isAuthenticated();

      // Students can read their own profile
      // Teachers can read student profiles (needed for no-due requests)
      // Admins can read student profiles
      allow read: if isAuthenticated() && (
        getProfileId() == usn ||  // Student reading own profile
        isTeacher() ||             // Teachers need to see student details
        isAdminUser()        // Admins need to see student details
      );
      
      // Students can create their own profile during signup
      // Admins can create student profiles
      allow create: if isAuthenticated() && (
        (isStudent() && getProfileId() == usn && request.resource.data.email == request.auth.token.email) ||
        isAdminUser()  // Admins can create student accounts
      );
      
      // Students can update their own profile (except usn and email)
      allow update: if isAuthenticated()
                    && getProfileId() == usn
                    && request.resource.data.usn == resource.data.usn
                    && request.resource.data.email == resource.data.email;
      
      // Only admins can delete students
      allow delete: if isAdminUser();
    }
    
    // =========================================================================
    // TEACHERS COLLECTION (Document ID: employeeId)
    // =========================================================================
    
    match /teachers/{employeeId} {
      // Anyone authenticated can read teacher profiles (needed for dropdowns, lookups)
      allow read: if isAuthenticated();
      
      // Teachers can create their own profile during signup
      // Admins can create teacher profiles
      allow create: if isAuthenticated() && (
        (isTeacher() && getProfileId() == employeeId && request.resource.data.email == request.auth.token.email) ||
        isAdminUser()  // Admins can create teacher accounts
      );
      
      // Teachers can update their own profile (except employeeId and email)
      allow update: if isAuthenticated()
                    && getProfileId() == employeeId
                    && request.resource.data.employeeId == resource.data.employeeId
                    && request.resource.data.email == resource.data.email;
      
      // Only admins can delete teachers
      allow delete: if isAdminUser();
    }
    
    // =========================================================================
    // ADMINS COLLECTION (Document ID: adminId)
    // =========================================================================
    
    match /admins/{adminId} {
      // Admins can read their own profile
      // Other admins can read admin profiles
      allow read: if isAuthenticated() && (
        getProfileId() == adminId ||
        isAdminUser()
      );
      
      // Super admin can create department admins, department admins can create/update their own profile
      allow create: if isAuthenticated() && (
        (isDepartmentAdmin() && getProfileId() == adminId && request.resource.data.email == request.auth.token.email) ||
        getUserRole() == 'admin'
      );
      
      // Admins can update their own profile (except adminId and email)
      allow update: if isAuthenticated()
                    && getProfileId() == adminId
                    && request.resource.data.adminId == resource.data.adminId
                    && request.resource.data.email == resource.data.email;
      
      // No one can delete admins via client
      allow delete: if false;
    }
    
    // =========================================================================
    // ACADEMIC_CONTEXT COLLECTION (Singleton: "current")
    // =========================================================================
    
    match /academic_context/current {
      // Everyone authenticated can read academic context
      allow read: if isAuthenticated();
      
      // Only admins can update academic context
      allow write: if isAdminUser();
    }
    
    // =========================================================================
    // CURRICULUM COLLECTION (Read-only for students/teachers)
    // =========================================================================
    
    match /curriculum/{docId} {
      // Everyone authenticated can read curriculum
      allow read: if isAuthenticated();
      
      // Only admins can write curriculum
      allow write: if isAdminUser();
    }
    
    // =========================================================================
    // CORE_SUBJECT_TEACHER_MAPPING COLLECTION
    // =========================================================================
    
    match /core_subject_teacher_mapping/{docId} {
      // Everyone authenticated can read mappings
      allow read: if isAuthenticated();
      
      // Only admins can write mappings
      allow write: if isAdminUser();
    }
    
    // =========================================================================
    // OPEN_ELECTIVE_OFFERINGS COLLECTION
    // =========================================================================
    
    match /open_elective_offerings/{docId} {
      // Everyone authenticated can read offerings
      allow read: if isAuthenticated();
      
      // Only admins can write offerings
      allow write: if isAdminUser();
    }
    
    // =========================================================================
    // STUDENT_ELECTIVE_CHOICE COLLECTION
    // =========================================================================
    
    match /student_elective_choice/{docId} {
      // Students can read their own choices
      // Teachers can read choices (to see their students)
      // Admins can read all choices
      allow read: if isAuthenticated() && (
        docId.matches('^' + getProfileId() + '_.*') ||  // Student's own choice
        isTeacher() ||
        isAdminUser()
      );
      
      // Only admins (including department admins) can maintain elective selections
      allow create, update: if isAuthenticated() && isAdminUser();
      
      // No one can delete choices
      allow delete: if false;
    }
    
    // =========================================================================
    // COMMON_CLEARANCE_TYPES COLLECTION (Read-only reference data)
    // =========================================================================
    
    match /common_clearance_types/{docId} {
      // Everyone authenticated can read clearance types
      allow read: if isAuthenticated();
      
      // Only admins can write clearance types
      allow write: if isAdminUser();
    }
    
    // =========================================================================
    // COMMON_CLEARANCE_MAPPING COLLECTION
    // =========================================================================
    
    match /common_clearance_mapping/{docId} {
      // Everyone authenticated can read mappings
      allow read: if isAuthenticated();
      
      // Only admins can write mappings
      allow write: if isAdminUser();
    }
    
    // =========================================================================
    // NO_DUE_REQUESTS COLLECTION (Core of the system)
    // =========================================================================
    
    match /no_due_requests/{docId} {
      // Students can read their own requests (docId starts with ND_{usn}_)
      // Teachers can read requests assigned to them
      // Admins can read all requests
      allow read: if isAuthenticated() && (
        docId.matches('^ND_' + getProfileId() + '_.*') ||  // Student's own request (legacy pattern)
        resource.data.usn == getProfileId() ||             // Student owns the document (canonical check)
        resource.data.teacherEmployeeId == getProfileId() ||  // Teacher's assigned request
        isAdminUser()  // Admin can see all
      );
      
      // Students can create their own requests; admins can dispatch on their behalf
      allow create: if isAuthenticated() && (
                      (
                        isStudent() &&
                        request.resource.data.usn == getProfileId() &&
                        docId.matches('^ND_' + getProfileId() + '_.*')
                      ) ||
                      (
                        isAdminUser() &&
                        request.resource.data.usn is string &&
                        docId.matches('^ND_' + request.resource.data.usn + '_.*')
                      )
                    );
      
      // Teachers can update status of their assigned requests; admins can regenerate without reassigning
      allow update: if isAuthenticated() && (
                      (
                        isTeacher()
                        && resource.data.teacherEmployeeId == getProfileId()
                        && request.resource.data.usn == resource.data.usn  // Can't change student
                        && request.resource.data.teacherEmployeeId == resource.data.teacherEmployeeId  // Can't reassign
                      ) ||
                      (
                        isAdminUser()
                        && request.resource.data.usn == resource.data.usn
                        && request.resource.data.teacherEmployeeId == resource.data.teacherEmployeeId
                      )
                    );
      
      // Only admins can delete requests
      allow delete: if isAdminUser();
    }
    
    // =========================================================================
    // LEGACY COLLECTIONS (Keep for backward compatibility if needed)
    // =========================================================================
    
    // Old subjects collection (deprecated, kept for backward compatibility)
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdminUser();
    }
    
    // Old noDueSubmissions collection (deprecated)
    match /noDueSubmissions/{submissionId} {
      allow read: if isAuthenticated();
      allow create: if isStudent();
      allow update: if isTeacher() || isAdminUser();
      allow delete: if isAdminUser();
    }
      
      // Only students can create submissions
      allow create: if isAuthenticated() 
                    && getUserRole() == 'student'
                    && request.resource.data.studentId == request.auth.uid;
      
      // Only the assigned teacher can update the submission (approve/reject)
      allow update: if isAuthenticated() 
                    && getUserRole() == 'teacher'
                    && resource.data.teacherId == request.auth.uid;
      
      // No one can delete submissions (maintain audit trail)
      allow delete: if false;
    }
    
    // No-Due Clearance collection (legacy - keeping for backward compatibility)
    match /noDueClearance/{clearanceId} {
      // Students can read their own clearance status
      // Teachers can read clearances for their department
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        getUserRole() == 'teacher'
      );
      
      // Only students can create their own no-due requests
      allow create: if isAuthenticated() 
                    && getUserRole() == 'student'
                    && request.resource.data.studentId == request.auth.uid;
      
      // Only teachers can update no-due status (approve/reject)
      allow update: if isAuthenticated() && getUserRole() == 'teacher';
      
      // No one can delete clearance records
      allow delete: if false;
    }
    
    // Approvals collection - for tracking teacher approvals
    match /approvals/{approvalId} {
      // Students can read their own approval records
      // Teachers can read all approvals
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        getUserRole() == 'teacher'
      );
      
      // Only authenticated users can write approval status
      allow write: if isAuthenticated();
    }
    
    // Research Papers collection (if needed for the portal)
    match /researchPapers/{paperId} {
      // Anyone can read research papers (public data)
      allow read: if true;
      
      // Only authenticated users can create research entries
      allow create: if isAuthenticated();
      
      // Users can update their own research papers
      allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      
      // Users can delete their own research papers
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }
    
    // Print Requests collection - for reprography admin print queue
    match /printRequests/{requestId} {
      // Students can read their own print requests
      // Reprography admins can read all requests
      allow read: if isAuthenticated() && (
        (resource != null && resource.data.studentId == request.auth.uid) ||
        getUserRole() == 'reprography_admin' ||
        getUserRole() == 'student'
      );
      
      // Only students can create print requests for approved submissions
      allow create: if isAuthenticated() 
                    && getUserRole() == 'student'
                    && request.resource.data.studentId == request.auth.uid;
      
      // Only reprography admins can update print request status
      allow update: if isAuthenticated() && getUserRole() == 'reprography_admin';
      
      // No one can delete print requests (maintain audit trail)
      allow delete: if false;
    }
    
    // No-Due Approvals collection - for parallel approval workflow
    match /noDueApprovals/{approvalId} {
      // Students can read their own approval requests
      // Teachers can read approval requests assigned to them
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.teacherId == request.auth.uid ||
        resource.data.teacherId == getProfileId() ||
        resource.data.teacherEmail == request.auth.token.email ||
        isAdminUser()
      );
      
      // Only students can create approval requests
      allow create: if isAuthenticated() 
                    && getUserRole() == 'student'
                    && request.resource.data.studentId == request.auth.uid;
      
      // Update rules:
      // - Teachers can update approval status (approve/reject)
      // - Students can resubmit their own rejected requests
      allow update: if isAuthenticated() && (
        (getUserRole() == 'teacher' && (resource.data.teacherId == request.auth.uid || resource.data.teacherId == getProfileId() || resource.data.teacherEmail == request.auth.token.email)) ||
        (getUserRole() == 'student' && resource.data.studentId == request.auth.uid && resource.data.status == 'rejected') ||
        isAdminUser()
      );
      
      // No one can delete approval requests (maintain audit trail)
      allow delete: if false;
    }
    
    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }

# =============================================================================
# University Research Portal - Environment Configuration
# =============================================================================
# Copy this file to .env and add your actual API keys
# This single .env file is used by:
#   - Frontend (Vite/React)
#   - Backend (Python/FastAPI)
#   - MCP Server (if needed)
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend Configuration (Vite - prefix with VITE_)
# -----------------------------------------------------------------------------

# Gemini AI API Key - Get from https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Groq AI API Key - Get from https://console.groq.com/keys
VITE_GROQ_API_KEY=your_groq_api_key_here

# Backend URL (optional - defaults to localhost:8000)
VITE_BACKEND_URL=http://localhost:8000

# Firebase Configuration - Get from Firebase Console
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# -----------------------------------------------------------------------------
# Backend Configuration (Python/FastAPI)
# -----------------------------------------------------------------------------

# Groq AI API Configuration (Backend)
GROQ_API_KEY=your_groq_api_key_here

# Gemini AI API Key (Backend)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAlex API Configuration (No API key required)
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_EMAIL=your-email@example.com

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Logging Configuration
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# MCP Server Configuration (optional - only if using MCP server)
# -----------------------------------------------------------------------------

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# Firestore Configuration (optional for persistence)
GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccountKey.json
FIRESTORE_PROJECT_ID=your-project-id
FIRESTORE_EMULATOR_HOST=localhost:8080

# API Security
API_KEY=your-super-secret-api-key-change-this
ADMIN_API_KEY=your-admin-api-key-change-this

# MCP Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
ENVIRONMENT=development

# Context Configuration
DEFAULT_CONTEXT_TTL=3600
MAX_CONTEXT_SIZE_MB=10
ENABLE_FIRESTORE_PERSISTENCE=false

# Tool Execution Configuration
DEFAULT_TOOL_TIMEOUT=60
MAX_TOOL_RETRIES=3
CIRCUIT_BREAKER_THRESHOLD=5

# Workflow Configuration
MAX_WORKFLOW_TIMEOUT=300
MAX_CONCURRENT_STEPS=5

# Ollama Configuration (for local LLMs)
OLLAMA_BASE_URL=http://localhost:11434

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
